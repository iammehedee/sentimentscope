# HuggingFace
HF_HOME=./.cache/huggingface
HF_DATASETS_CACHE=./.cache/huggingface/datasets

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sentimentscope

# Model
MODEL_NAME=distilbert-base-uncased
MAX_LENGTH=128
BATCH_SIZE=16
EPOCHS=3
LEARNING_RATE=2e-5

# API
API_HOST=0.0.0.0
API_PORT=8000

# WandB (optional)
WANDB_PROJECT=sentimentscope
